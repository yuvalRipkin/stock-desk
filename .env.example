# Postgres (read by docker-compose.yml). DATABASE_URL below must use the same user/password/db.
POSTGRES_USER=stockdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockdesk

# Infrastructure / secrets
DATABASE_URL=postgresql+psycopg://stockdesk:change-me@localhost:5432/stockdesk
OPENAI_API_KEY=sk-your-openai-key
LOG_LEVEL=INFO

# Experiment config. LLM_MODEL is required; the rest are shown with their defaults, which are
# the best config so far (experiment 012). Results files record the config of earlier ones.
LLM_MODEL=gpt-5.4-mini
# JUDGE_MODEL=gpt-5.4
# TABLE=naive_1000_large
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072       # must match the model: 1536 for -3-small, 3072 for -3-large
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# CHUNKING=plain           # plain | section_header (split at 10-K sections, title prepended)
# RETRIEVAL_K=10
# RETRIEVER=expand         # naive | expand
# MAX_PAGES=5              # expand only: full pages sent to the LLM
# EXCLUDE_EXHIBITS=true    # false: also retrieve pages of attached exhibits
# QUERY_REWRITE=none       # none | multi (multi requires RETRIEVER=expand)
# N_REWRITES=3             # multi only: rewritten search queries per question
# REWRITE_MODEL=gpt-5.4-mini  # multi only: model that writes the queries
# HYBRID=none              # none | bm25 (BM25 fused with vector search by RRF; needs expand)
# BM25_K=10                # bm25 only: keyword-ranked chunks per question
# ANSWER_PROMPT=v2         # v2: figures, step-by-step arithmetic, an Answer: line | v1: direct
